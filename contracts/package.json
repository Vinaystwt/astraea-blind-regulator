{
  "name": "@astraea/contracts",
  "version": "1.0.0",
  "description": "Astraea FHEVM contracts and deployment scripts",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "seed:local": "hardhat run scripts/seed-local.ts --network localhost",
    "deploy:sepolia": "ts-node scripts/deploy-sepolia.ts",
    "open:sepolia": "ts-node scripts/open-sepolia.ts",
    "seed:sepolia": "ts-node scripts/seed-sepolia.ts",
    "actors:status": "ts-node scripts/actors-status.ts",
    "actors:import-help": "ts-node scripts/local-print-actor-import-instructions.ts",
    "fund:actors": "ts-node scripts/fund-actors.ts",
    "verify:sepolia": "ts-node scripts/verify-sepolia.ts",
    "sync:frontend": "ts-node scripts/sync-frontend.ts",
    "export:frontend": "hardhat run scripts/export-frontend-artifacts.ts"
  },
  "keywords": [],
  "author": "vinay",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@fhevm/hardhat-plugin": "^0.4.2",
    "@fhevm/mock-utils": "^0.4.2",
    "@fhevm/solidity": "^0.11.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@zama-fhe/relayer-sdk": "^0.4.1",
    "chai": "^4.5.0",
    "chai-as-promised": "^8.0.2",
    "dotenv": "^17.4.2",
    "encrypted-types": "^0.0.4",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  }
}
